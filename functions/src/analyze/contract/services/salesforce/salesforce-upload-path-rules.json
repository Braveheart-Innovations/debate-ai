{
  "version": 1,
  "supportedTopLevelFiles": [
    "package.xml",
    "sfdx-project.json"
  ],
  "insightPacketFiles": [
    "manifest.json",
    "findings.json",
    "evidence.md",
    "transcript.md",
    "limits.csv",
    "drift.json"
  ],
  "ignoredMetadataPathSegments": [
    ".git",
    ".sfdx",
    ".sf",
    "node_modules",
    "coverage"
  ],
  "ignoredWorkspaceBundlePathSegments": [
    ".git",
    ".sfdx",
    ".sf",
    "node_modules",
    "coverage",
    ".next",
    "out",
    "__pycache__"
  ],
  "metadataSegmentRules": [
    {
      "segment": "classes",
      "suffixes": [".cls"]
    },
    {
      "segment": "triggers",
      "suffixes": [".trigger"]
    },
    {
      "segment": "lwc",
      "suffixes": [".js", ".html", ".css", ".svg", ".xml"]
    },
    {
      "segment": "aura",
      "suffixes": [".cmp", ".app", ".design", ".evt", ".js", ".css", ".svg", ".auradoc"]
    },
    {
      "segment": "flows",
      "suffixes": [".flow-meta.xml", ".flow"]
    },
    {
      "segment": "permissionsets",
      "suffixes": [".permissionset-meta.xml", ".permissionset"]
    },
    {
      "segment": "profiles",
      "suffixes": [".profile-meta.xml", ".profile"]
    },
    {
      "segment": "layouts",
      "suffixes": [".layout-meta.xml", ".layout"]
    },
    {
      "segment": "custommetadata",
      "suffixes": [".md-meta.xml", ".md"]
    }
  ],
  "objectMetadataSuffixes": [
    ".object",
    ".object-meta.xml",
    ".field-meta.xml",
    ".validationrule-meta.xml"
  ],
  "excludedWorkspaceSegments": ["objecttranslations", "__tests__"],
  "excludedWorkspaceFiles": [".ds_store", "jsconfig.json", ".eslintrc.json"],
  "binaryContentFolders": ["staticresources", "documents", "contentassets", "sitedotcomsites"],
  "runRecordPath": ".symposium/salesforce-runs/latest.json"
}
