{
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  "moderate": true,
  "allowlist": [
    // zod memory exhaustion while validating oversized collections (high); fixed
    // only in zod 4.6.6. Our own zod is 4.6.7. Allowlisted for this one path:
    // puppeteer-core 25.1.0 (pinned to match @sparticuz/chromium 149) pins
    // chromium-bidi 16.0.1, which pins zod 3. chromium-bidi is Puppeteer's
    // WebDriver BiDi mapper, loaded only for `protocol: 'webDriverBiDi'`; every
    // launch here (exports/browserService.ts, salesforceDocsIndex.ts) uses the
    // default CDP, so this zod never runs. Allowlisted 2026-10-24; REMOVE when
    // puppeteer-core is upgraded (25.16.0 ships chromium-bidi on zod 4).
    "GHSA-mrhx-c7xc-m3w5|puppeteer-core>chromium-bidi>zod"
  ]
}
