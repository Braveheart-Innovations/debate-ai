{
  "name": "symposium-ai",
  "version": "2.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:attach": "adb reverse tcp:8081 tcp:8081 && adb shell am force-stop com.braveheartinnovations.debateai && adb shell am start -n com.braveheartinnovations.debateai/.MainActivity",
    "android:dev:reset": "bash scripts/dev/reset-android-dev-client.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "clean": "rm -rf ios android node_modules && npm install",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock && pod install && cd ..",
    "build:dev:ios": "eas build --platform ios --profile development --local",
    "build:dev:android": "eas build --platform android --profile development --local",
    "lint": "npm run lint:src && npm run lint:tests",
    "lint:src": "eslint src --ext .ts,.tsx",
    "lint:tests": "eslint __tests__ --ext .ts,.tsx",
    "lint:any-budget": "node scripts/quality/check-no-explicit-any-budget.mjs",
    "lint:fix": "eslint src __tests__ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check:app": "npm run typecheck && npm run lint && npm run lint:any-budget && npm run test",
    "check:functions": "npm --prefix functions run build && npm --prefix functions test",
    "audit:all": "audit-ci --config audit-ci.jsonc && npm --prefix functions audit --audit-level=moderate",
    "check:all": "npm run check:app && npm run check:functions && npm run audit:all",
    "check": "npm run check:app",
    "models:discover": "node scripts/discover-provider-models.mjs",
    "models:discover:check": "node scripts/discover-provider-models.mjs --check",
    "salesforce-docs:index": "npm --prefix functions run salesforce-docs:index --",
    "demo:build-recordings": "node scripts/demo/build-recordings-manifest.js",
    "demo:bridge": "node scripts/demo/dev-bridge.mjs",
    "purchase:test:inspect": "node scripts/purchase-testing/firestore-state.mjs inspect",
    "purchase:test:repair-trial": "node scripts/purchase-testing/firestore-state.mjs repair-trial-flag",
    "purchase:test:reset-entitlement": "node scripts/purchase-testing/firestore-state.mjs reset-entitlement",
    "purchase:test:reset-trial": "node scripts/purchase-testing/firestore-state.mjs reset-trial-eligibility",
    "purchase:test:capture-android": "bash scripts/purchase-testing/capture-android-purchase-evidence.sh",
    "test": "jest --watch=false --runInBand",
    "test:model-routing": "jest --runInBand __tests__/config/modelSelectionContract.test.ts __tests__/services/ai/ModelRoutingContract.test.ts __tests__/services/modelSelectionFlow.test.ts __tests__/services/home/AIConfigurationService.test.ts",
    "test:model-routing:live": "LIVE_MODEL_TEST=1 jest --runInBand --runTestsByPath __tests__/integration/liveModelRouting.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "eas-build-post-install": "bash scripts/eas-prebuild.sh",
    "release:preflight": "node scripts/release/preflight-version.mjs",
    "release:build": "npm run release:preflight && eas build --platform all --profile production --non-interactive --no-wait",
    "release:submit": "npm run release:preflight -- --phase submit && eas submit --platform ios --profile production --latest --non-interactive && eas submit --platform android --profile production --latest --non-interactive"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/app-check": "^26.2.0",
    "@react-native-firebase/auth": "^26.2.0",
    "@react-native-firebase/crashlytics": "^26.2.0",
    "@react-native-firebase/firestore": "^26.2.0",
    "@react-native-firebase/functions": "^26.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.5",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.13.6",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-iap": "^14.7.20",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^9.33.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^12.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.67.0",
    "audit-ci": "^7.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "msw": "^2.4.10",
    "node-forge": "^1.3.3",
    "react-test-renderer": "^19.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "undici": "^7.29.0",
    "whatwg-fetch": "^3.6.20"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.6.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "markdown-it": "^14.3.0",
    "prismjs": "^1.30.0",
    "tar": "^7.5.7",
    "lodash": "^4.17.23",
    "fast-xml-parser": "^5.7.0",
    "http-proxy-agent": "^7.0.2",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "protobufjs": "^7.5.8",
    "@protobufjs/utf8": "^1.1.1",
    "websocket-driver": "^0.7.5"
  },
  "private": true
}
