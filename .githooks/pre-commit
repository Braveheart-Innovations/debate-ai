#!/bin/sh
echo "Running pre-commit checks..."

# Git hooks launched from GUI tools can inherit a minimal PATH that does not
# include Homebrew or nvm-managed Node binaries.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  if [ -f .nvmrc ]; then
    nvm use --silent >/dev/null 2>&1 || true
  fi
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "npm not found. Install Node with nvm or ensure npm is on PATH before committing." >&2
  exit 1
fi

# TypeScript typecheck (app + tests)
npm run -s typecheck || {
  echo "Typecheck failed. Aborting commit." >&2
  exit 1
}

# ESLint
npm run -s lint || {
  echo "Lint failed. Aborting commit." >&2
  exit 1
}

npm run -s lint:escape-hatches || {
  echo "Escape-hatch budget failed. Aborting commit." >&2
  exit 1
}

echo "All pre-commit checks passed."
